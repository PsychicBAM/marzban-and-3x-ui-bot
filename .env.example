# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321

# PostgreSQL
POSTGRES_USER=vpn_bot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vpn_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vpn_bot:change_me_strong_password@postgres:5432/vpn_bot

# Application
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
DEFAULT_ISSUING_MODE=both

# Marzban panel
MARZBAN_ENABLED=true
MARZBAN_BASE_URL=https://marzban.example.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=change_me
MARZBAN_API_TOKEN=
MARZBAN_SUBSCRIPTION_BASE_URL=
MARZBAN_VERIFY_SSL=true
MARZBAN_INBOUND_VLESS=vless-tcp-reality
MARZBAN_INBOUND_TROJAN=trojan-tcp-notls
MARZBAN_INBOUND_VMESS=vmess-tcp-notls

# 3x-ui panel
XUI_ENABLED=true
XUI_BASE_URL=https://xui.example.com
XUI_API_TOKEN=
XUI_USERNAME=admin
XUI_PASSWORD=change_me
XUI_INBOUND_ID=1
XUI_SUBSCRIPTION_BASE_URL=
XUI_VERIFY_SSL=true

# Payment details (shown to customers; override via admin settings later)
PAYMENT_DETAILS=Переведите сумму на карту: 0000 0000 0000 0000\nБанк: Example Bank\nПолучатель: Example Name

# Support & instruction (override via admin ⚙️ Настройки)
SUPPORT_USERNAME=your_support_username
SUPPORT_URL=
SUPPORT_TEXT=
INSTRUCTION_TEXT=
INSTRUCTION_URL=https://example.com/instruction
INSTRUCTION_ENABLED=true

# Expiry notifications (override via admin ⚙️ → 🔔 Уведомления)
NOTIFICATIONS_ENABLED=true
NOTIFICATION_DAYS=7,3,1
NOTIFICATION_CHECK_INTERVAL=daily
NOTIFICATION_TEST_MODE=false
NOTIFY_EXPIRED_ENABLED=true
